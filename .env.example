# IBVAP — module addressing.
#
# Copy to `.env` and edit. Every module reads its addresses from here and
# nowhere else, so moving a module to another machine is changing one line,
# not editing code.
#
# The four modules can each run on a different box:
#
#   media hub      MediaMTX          RTSP to workers, WHEP to browsers
#   vision service Python            decode -> detect -> track
#   edge node      Bun               zones, events, incidents, audit
#   console        static frontend   the operator's screen
#
# Spreading the vision workers is the point: one worker per team laptop
# against a shared media host is how four cameras fit on hardware where
# four workers on one box would not.


# ─────────────────────────────────────────────── media hub (MediaMTX)

# The machine running mediamtx.exe. Workers pull RTSP from it and browsers
# pull WHEP from it. On a single-box setup leave this as loopback.
IBVAP_MEDIA_HOST=127.0.0.1
IBVAP_RTSP_PORT=8554
IBVAP_WHEP_PORT=8889

# Bind address for the hub itself. 0.0.0.0 lets other machines reach it;
# 127.0.0.1 keeps it local-only. Set this on the media host, not on clients.
IBVAP_MEDIA_BIND=0.0.0.0

# WebRTC hands the browser a list of IPs to connect back on, gathered from
# the host's network interfaces. On a Windows dev laptop that list usually
# includes Hyper-V, WSL and VirtualBox adapters, and the browser may pick a
# dead one — the symptom is a tile that connects and then stays black.
# Put the media host's REAL LAN IP here to settle it. Leave empty on a
# single-box setup.
IBVAP_MEDIA_ADVERTISE_IP=


# ─────────────────────────────────────────────── edge node (Bun backend)

IBVAP_BACKEND_HOST=127.0.0.1
IBVAP_BACKEND_PORT=8000

# Where the SQLite file lives, relative to backend/ unless absolute.
# One file, one process. Do not point two edge nodes at the same file.
IBVAP_DB=ibvap.db


# ─────────────────────────────────────────────── box channel (vision -> browser)

# The hot path: raw detections pushed to the console for the live overlay.
# Ephemeral — never stored, never replayed. Served BY the vision service.
IBVAP_BOXES_BIND=0.0.0.0
IBVAP_BOXES_PORT=8100

# What the BROWSER should dial. Differs from the bind address whenever the
# vision service is on another machine.
IBVAP_BOXES_HOST=127.0.0.1


# ─────────────────────────────────────────────── what THIS machine does

# Comma-separated camera ids from media/cameras.yml, or `all`.
# This is the per-machine knob: give each team laptop one camera and the
# four-worker layout costs each machine a single stream.
#
#   laptop A   IBVAP_WORKER_CAMERAS=cam_fence_north
#   laptop B   IBVAP_WORKER_CAMERAS=cam_farm_gate
#   one box    IBVAP_WORKER_CAMERAS=all
IBVAP_WORKER_CAMERAS=all


# ───────────────────────────────────────────── CPU budget

# Processed frames per second, PER CAMERA. Not the camera's frame rate — the
# capture thread still reads the stream at full speed and throws away what the
# detector did not get to, so latency stays bounded either way.
#
# Capping here is what keeps several cameras on one box sane. The overlay still
# reads as live at 5–10 fps because a person crossing a fence does not move far
# in 150 ms, while the detector — the expensive part — does a fraction of the
# work. Every confirm window is measured in seconds, so changing this does not
# silently change what a zone's wait-and-confirm setting means.
IBVAP_TARGET_FPS=6

# Inference size. The biggest single win when too slow, and it costs accuracy
# on small distant subjects and plates. Tune this before target_fps.
IBVAP_IMGSZ=480

# Detector confidence floor.
IBVAP_CONF=0.35

# Detector weights. yolo11n only on CPU hardware.
IBVAP_WEIGHTS=yolo11n.pt

# YuNet face-detection weights, used by modules/face.py on cameras that run
# it. A camera's own `face: {model: ...}` param overrides this.
IBVAP_FACE_MODEL=data/face_detection_yunet_2023mar.onnx

# Optional vision-model fallback. When EasyOCR cannot read a tracked vehicle,
# only the tight lower-centre plate crop is sent. The returned text is shown as
# an UNVERIFIED estimate and never triggers a watchlist match automatically.
IBVAP_LLM_PLATE_FALLBACK=true
# `auto` prefers Gemini when its key exists, then falls back to OpenAI.
IBVAP_LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna

# How often the vision service re-reads zones from the edge node's /api/config.
# Fence evaluation runs in the vision service, but zones are drawn and edited by
# an operator and stored by the node — this is the interval within which an edit
# reaches the detector judging it. Lower for a demo, raise on a slow link.
IBVAP_ZONE_REFRESH_SECONDS=15
