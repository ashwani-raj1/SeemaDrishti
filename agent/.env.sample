# OpenRouter (or any OpenAI-compatible Chat Completions endpoint)
LLM_API_KEY=
LLM_MODEL_STRING=anthropic/claude-sonnet-5
LLM_BASEURL=https://openrouter.ai/api/v1
# Optional comma-separated models OpenRouter falls back to on rate limits / outages
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free
# SeemaDrishti MCP
SEEMADRISHTI_MCP_URL=http://localhost:13000/mcp
# Optional backend actor forwarded as x-ibvap-actor (defaults to usr_operator)
IBVAP_ACTOR=

# Time zone used to interpret "today"/"last night" and to display times
DISPLAY_TZ=Asia/Kolkata
